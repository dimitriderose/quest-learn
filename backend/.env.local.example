# Local Development Environment Variables
# Copy this to .env.local and fill in your values
# This file is for LOCAL DEVELOPMENT ONLY (with docker-compose.yml)

# PostgreSQL (for docker-compose.yml)
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_secure_password

# Database Connection (for Spring Boot)
DATABASE_URL=jdbc:postgresql://localhost:5432/your_database_name
DATABASE_USERNAME=your_database_user
DATABASE_PASSWORD=your_secure_password

# Spring Profile (use 'dev' for local development)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# Firebase Authentication (Required - get from Firebase Console)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Gemini AI (Required - get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id

# CORS (Frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
