# QuestLearn Environment Variables Template
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in the .env file
# 3. NEVER commit .env to version control!
#
# IMPORTANT: All values below are PLACEHOLDERS. Replace with your actual credentials.

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================

# Database name (use any name you prefer)
POSTGRES_DB=

# Database username (create a secure username)
POSTGRES_USER=

# Database password (MUST be strong and unique)
POSTGRES_PASSWORD=

# PostgreSQL Connection String for Spring Boot
# Note: Use 'postgres' as hostname when running in Docker (container name)
#       Use 'localhost' when running Spring Boot locally outside Docker
DATABASE_URL=jdbc:postgresql://postgres:5432/YOUR_DB_NAME
DATABASE_USERNAME=
DATABASE_PASSWORD=

# =============================================================================
# Firebase Configuration
# =============================================================================

# Firebase Project ID
# - For local dev with emulator: Use 'demo-questlearn' (no quotes)
# - For production: Use your actual Firebase project ID
FIREBASE_PROJECT_ID=

# Firestore Emulator Host
# - For local dev in Docker: Use 'firebase:8080'
# - For local dev outside Docker: Use 'localhost:8080'
# - For production: Leave empty
FIRESTORE_EMULATOR_HOST=

# Firebase Service Account Credentials Path (PRODUCTION ONLY)
# - For local dev with emulator: Leave empty
# - For production: Full path to your service account JSON file
#   Example: /app/secrets/firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=

# =============================================================================
# Google AI (Gemini) Configuration
# =============================================================================

# Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
# REQUIRED for AI curriculum generation
GEMINI_API_KEY=

# Your Google Cloud Project ID
# Find this in your Google Cloud Console
GOOGLE_CLOUD_PROJECT_ID=

# =============================================================================
# Standards API
# =============================================================================

# Common Standards Project API URL
# Default value works for most cases
STANDARDS_API_URL=https://api.commonstandardsproject.com

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed frontend origins (comma-separated for multiple)
# For local development, use: http://localhost:3000
# For production, use your actual frontend domain
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Server Configuration
# =============================================================================

# Spring Profile (dev, prod)
# Use 'dev' for local development
# Use 'prod' for production deployment
SPRING_PROFILE=dev

# Server Port (internal Docker port)
# Default: 8080
PORT=8080
