# ===========================================
# QuestLearn Backend Environment Variables
# ===========================================
#
# Copy this file to `.env` and fill in your actual values
# DO NOT commit `.env` to version control!
#

# ===========================================
# Spring Configuration
# ===========================================
SPRING_PROFILE=dev

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=jdbc:postgresql://postgres:5432/questlearn
DATABASE_USERNAME=questlearn
DATABASE_PASSWORD=your_secure_password_here

# ===========================================
# Google OAuth2 Configuration
# ===========================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# 1. Create OAuth 2.0 Client ID
# 2. Configure OAuth consent screen
# 3. Add authorized redirect URIs:
#    - http://localhost:8080/login/oauth2/code/google (backend)
#    - http://localhost:3000/auth/callback (frontend)
#
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===========================================
# JWT Configuration
# ===========================================
# Generate a secure secret:
# openssl rand -base64 64
#
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# ===========================================
# OAuth2 Redirect URIs
# ===========================================
# Comma-separated list of allowed frontend redirect URIs
OAUTH2_REDIRECT_URIS=http://localhost:3000/auth/callback,https://questlearn.app/auth/callback

# ===========================================
# OAuth2 Domain Restrictions (Optional)
# ===========================================
# Comma-separated list of allowed email domains
# Empty = allow ALL Google accounts (recommended for development)
#
# Examples:
# - Allow all: (leave empty)
# - Allow specific domains: gmail.com,school.edu,district.org
# - School emails only: edu,k12.us
#
OAUTH2_ALLOWED_DOMAINS=

# ===========================================
# Google AI (Gemini 3) Configuration
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here

# ===========================================
# Standards API Configuration (Optional)
# ===========================================
STANDARDS_API_URL=https://api.commonstandardsproject.com

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://questlearn.app

# ===========================================
# Server Configuration
# ===========================================
PORT=8080
