# Database Configuration (Required)
DATABASE_URL=jdbc:postgresql://localhost:5432/questlearn
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# Spring Profile (Optional - defaults to 'dev')
SPRING_PROFILE=dev

# Server Port (Optional - defaults to 8080)
PORT=8080

# Gemini AI Configuration (Required for curriculum generation)
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id

# Firebase Authentication (Required)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Standards API (Optional - has default)
STANDARDS_API_URL=https://api.commonstandardsproject.com

# CORS Configuration (Optional - defaults to localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000
