# ===========================================
# QuestLearn Environment Variables
# ===========================================
#
# Copy this file to `.env` and fill in your actual values
# DO NOT commit `.env` to version control!
#

# ===========================================
# Spring Configuration
# ===========================================
SPRING_PROFILE=dev

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_DB=questlearn
POSTGRES_USER=questlearn
POSTGRES_PASSWORD=your_secure_password_here

# ===========================================
# Google OAuth2 Configuration
# ===========================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# 1. Create OAuth 2.0 Client ID
# 2. Configure OAuth consent screen
# 3. Add authorized redirect URIs:
#    - http://localhost:8080/login/oauth2/code/google (backend)
#    - http://localhost:3000/auth/callback (frontend)
#
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===========================================
# JWT Configuration
# ===========================================
# Generate a secure secret with PowerShell:
# $bytes = New-Object byte[] 64; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($bytes); [Convert]::ToBase64String($bytes)
#
# Or with OpenSSL (Git Bash/Linux/Mac):
# openssl rand -base64 64
#
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# ===========================================
# OAuth2 Redirect URIs
# ===========================================
# Comma-separated list of allowed frontend redirect URIs
OAUTH2_REDIRECT_URIS=http://localhost:3000/auth/callback,https://questlearn.app/auth/callback

# ===========================================
# OAuth2 Domain Restrictions (Optional)
# ===========================================
# Comma-separated list of allowed email domains
# Empty = allow ALL Google accounts (recommended for development)
#
# Examples:
# - Allow all: (leave empty)
# - Allow specific domains: gmail.com,school.edu,district.org
# - School emails only: edu,k12.us
#
OAUTH2_ALLOWED_DOMAINS=

# ===========================================
# Google AI (Gemini 3) Configuration
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here

# ===========================================
# Common Standards Project API Configuration
# ===========================================
# Public API - No authentication required
# Provides access to 1M+ educational standards from all 50 US states
#
COMMON_STANDARDS_API_URL=https://api.commonstandardsproject.com
COMMON_STANDARDS_CACHE_TTL_HOURS=24
COMMON_STANDARDS_CACHE_MAX_SIZE=1000
COMMON_STANDARDS_DB_CACHE_DAYS=7
COMMON_STANDARDS_API_TIMEOUT_SECONDS=10
COMMON_STANDARDS_API_MAX_RETRIES=2

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://questlearn.app

# ===========================================
# Server Configuration
# ===========================================
PORT=8080
